{
  "rules": {
    ".read": false,
    ".write": false,
    "active_sos": {
      ".read": "auth != null",
      "$sosId": {
        ".write": "auth != null && (!data.exists() || data.child('ownerId').val() == auth.uid || newData.child('ownerId').val() == auth.uid)",
        ".validate": "newData.hasChildren(['id','ownerId','latitude','longitude','active','updatedAt'])"
      }
    },
    "sos_assignments": {
      "$sosId": {
        ".read": "auth != null && root.child('active_sos').child($sosId).child('ownerId').val() == auth.uid",
        "$helperId": {
          ".read": "auth != null && (auth.uid == $helperId || root.child('active_sos').child($sosId).child('ownerId').val() == auth.uid)",
          ".write": "auth != null && auth.uid == $helperId",
          ".validate": "newData.hasChildren(['acceptedAt', 'status'])"
        }
      }
    },
    "sos_chats": {
      "$sosId": {
        ".read": "auth != null && root.child('active_sos').child($sosId).child('ownerId').val() == auth.uid",
        "$helperId": {
          ".read": "auth != null && (auth.uid == $helperId || root.child('active_sos').child($sosId).child('ownerId').val() == auth.uid)",
          ".write": "auth != null && (auth.uid == $helperId || root.child('active_sos').child($sosId).child('ownerId').val() == auth.uid)",
          "messages": {
            "$msgId": {
              ".validate": "newData.hasChildren(['senderId', 'type', 'createdAt']) && (newData.child('senderId').val() == auth.uid || data.exists())"
            }
          }
        }
      }
    },
    "user_tokens": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['token', 'updatedAt'])"
      }
    }
  }
}
